// ============================================================================
// Bundlebase Custom SQL Grammar
// ============================================================================
// This grammar covers bundlebase-specific SQL extensions that aren't
// recognized by sqlparser-rs. Standard SQL continues to use sqlparser-rs.
//
// Operations covered:
// - Data: FILTER, ATTACH, DETACH, REPLACE
// - Schema: JOIN, DROP JOIN, RENAME JOIN, ADD/DROP/RENAME/CAST COLUMN,
//           CREATE/DROP/RENAME VIEW
// - Sources: IMPORT [TEMP] CONNECTOR/FUNCTION, RENAME [TEMP] CONNECTOR/FUNCTION,
//            DROP [TEMP] CONNECTOR/FUNCTION, CREATE SOURCE, FETCH
// - Indexes: CREATE/DROP/REBUILD INDEX, REINDEX
// - Transactions: COMMIT, RESET, UNDO, VERIFY DATA, EXPLAIN
// - Metadata: DESCRIBE CONNECTOR, DESCRIBE FUNCTION,
//             SET NAME/DESCRIPTION/CONFIG, SAVE CONFIG
// ============================================================================

WHITESPACE = _{ " " | "\t" | "\r" | "\n" }
COMMENT = _{ "--" ~ (!"\n" ~ ANY)* ~ "\n" }

// ============================================================================
// Entry Point - Statement Types by Category
// ============================================================================
// Statements are organized into semantic groups for easier navigation.
// When adding a new statement, add it to the appropriate category below.

statement = { SOI ~ (
    data_modification_stmt
    | schema_stmt
    | source_stmt
    | index_stmt
    | transaction_stmt
    | metadata_stmt
) ~ EOI }

// Multi-statement input: semicolon-separated statements.
// Respects single-quoted strings so semicolons inside quotes are not treated as delimiters.
// This rule is used by the CLI for batch execution; the core library uses `statement` for single commands.
multi_statement = { SOI ~ statement_text ~ (";" ~ statement_text)* ~ ";"? ~ EOI }
statement_text  = { (quoted_string | !(";" | EOI) ~ ANY)+ }

// Data modification statements - operations that change bundle data content
data_modification_stmt = {
    update_stmt
    | always_update_stmt
    | drop_always_update_stmt
    | always_delete_stmt
    | drop_always_delete_stmt
    | delete_stmt
    | import_join_stmt
    | filter_stmt
    | attach_stmt
    | detach_stmt
    | replace_stmt
}

// Schema modification statements - operations that change bundle structure
schema_stmt = {
    join_stmt
    | drop_join_stmt
    | rename_join_stmt
    | drop_column_stmt
    | rename_column_stmt
    | cast_column_stmt
    | add_column_stmt
    | create_view_stmt
    | drop_view_stmt
    | rename_view_stmt
}

// Source management statements - operations for data sources and functions
// Note: temp variants must come before non-temp to match the longer prefix first
source_stmt = {
    import_temp_function_stmt
    | import_temp_connector_stmt
    | import_function_stmt
    | import_connector_stmt
    | rename_temp_function_stmt
    | rename_temp_connector_stmt
    | rename_function_stmt
    | rename_connector_stmt
    | drop_temp_function_stmt
    | drop_temp_connector_stmt
    | drop_function_stmt
    | drop_connector_stmt
    | create_source_stmt
    | fetch_stmt
}

// Index management statements - operations for search indexes
index_stmt = {
    create_index_stmt
    | drop_index_stmt
    | rebuild_index_stmt
    | reindex_stmt
}

// Transaction control statements - operations for version control
transaction_stmt = {
    commit_stmt
    | reset_stmt
    | undo_stmt
    | verify_data_stmt
    | explain_stmt
}

// Metadata statements - operations for bundle metadata
metadata_stmt = {
    export_stmt
    | show_details_stmt
    | show_history_stmt
    | show_status_stmt
    | show_views_stmt
    | show_indexes_stmt
    | show_packs_stmt
    | show_blocks_stmt
    | show_config_stmt
    | show_commands_stmt
    | show_connectors_stmt
    | show_functions_stmt
    | show_columns_stmt
    | show_count_stmt
    | show_always_deletes_stmt
    | show_always_updates_stmt
    | syntax_stmt
    | describe_data_stmt
    | describe_connector_stmt
    | describe_function_stmt
    | set_name_stmt
    | set_description_stmt
    | set_config_stmt
    | save_config_stmt
}

// ============================================================================
// SYNTAX Statement
// ============================================================================
// Syntax: SYNTAX [<command>]
// Examples:
//   SYNTAX                     -- list all available commands
//   SYNTAX ATTACH              -- show syntax for ATTACH command
//   SYNTAX IMPORT CONNECTOR    -- show syntax for IMPORT CONNECTOR

syntax_stmt = {
    ^"syntax" ~ syntax_query?
}

syntax_query = @{
    (!EOI ~ ANY)+
}

// ============================================================================
// EXPORT Statement
// ============================================================================
// Syntax: EXPORT TO '<path>' <sql>
// Examples:
//   EXPORT TO 'output.csv' SELECT * FROM bundle
//   EXPORT TO '/tmp/results.json' SELECT name, count FROM bundle WHERE active = true
//   EXPORT TO 'data.table' SELECT * FROM bundle LIMIT 100

export_stmt = {
    ^"export" ~ ^"to" ~ quoted_string ~ export_sql
}

export_sql = @{
    (!EOI ~ ANY)+
}

// ============================================================================
// SHOW Statements
// ============================================================================
// Each SHOW target has its own grammar rule.
// Examples:
//   SHOW HISTORY       -- show commit history
//   SHOW STATUS        -- show uncommitted changes
//   SHOW DETAILS       -- show bundle metadata
//   SHOW COUNT         -- show row count

show_details_stmt    = { ^"show" ~ ^"details" }
show_history_stmt    = { ^"show" ~ ^"history" }
show_status_stmt     = { ^"show" ~ ^"status" }
show_views_stmt      = { ^"show" ~ ^"views" }
show_indexes_stmt    = { ^"show" ~ ^"indexes" }
show_packs_stmt      = { ^"show" ~ ^"packs" }
show_blocks_stmt     = { ^"show" ~ ^"blocks" }
show_config_stmt     = { ^"show" ~ ^"config" }
show_commands_stmt   = { ^"show" ~ ^"commands" }
show_connectors_stmt = { ^"show" ~ ^"connectors" }
show_functions_stmt  = { ^"show" ~ ^"functions" }
show_columns_stmt    = { ^"show" ~ ^"columns" }
show_count_stmt      = { ^"show" ~ ^"count" }
show_always_deletes_stmt = { ^"show" ~ ^"always" ~ ^"deletes" }
show_always_updates_stmt = { ^"show" ~ ^"always" ~ ^"updates" }

// ============================================================================
// IMPORT JOIN Statement
// ============================================================================
// Syntax: IMPORT JOIN <name> [FLATTEN HISTORY]
// Examples:
//   IMPORT JOIN stations
//   IMPORT JOIN stations FLATTEN HISTORY

import_join_stmt = {
    ^"import" ~ ^"join" ~ identifier ~ import_join_flatten?
}

import_join_flatten = { ^"flatten" ~ ^"history" }

// ============================================================================
// ALWAYS DELETE Statement
// ============================================================================
// Syntax: ALWAYS DELETE FROM bundle WHERE <condition>
// Creates a persistent rule that auto-deletes matching rows on every future ATTACH.
// Also immediately deletes matching rows from current data.

always_delete_stmt = {
    ^"always" ~ ^"delete" ~ ^"from" ~ ^"bundle" ~ ^"where" ~ delete_where_clause
}

// ============================================================================
// DROP ALWAYS DELETE Statement
// ============================================================================
// Syntax: DROP ALWAYS DELETE [WHERE <condition>]
// Without WHERE: removes all always-delete rules.
// With WHERE: removes the specific matching rule.

drop_always_delete_stmt = {
    ^"drop" ~ ^"always" ~ ^"delete" ~ (^"where" ~ delete_where_clause)?
}

// ============================================================================
// ALWAYS UPDATE Statement
// ============================================================================
// Syntax: ALWAYS UPDATE bundle SET <col> = <expr> [, ...] WHERE <condition>
// Creates a persistent rule that auto-updates matching rows on every future ATTACH.
// Also immediately updates matching rows in current data.

always_update_stmt = {
    ^"always" ~ ^"update" ~ ^"bundle" ~ ^"set" ~ update_set_clause ~ ^"where" ~ update_where_clause
}

// ============================================================================
// DROP ALWAYS UPDATE Statement
// ============================================================================
// Syntax: DROP ALWAYS UPDATE [SET <col> = <expr> [, ...] WHERE <condition>]
// Without SET/WHERE: removes all always-update rules.
// With SET/WHERE: removes the specific matching rule.

drop_always_update_stmt = {
    ^"drop" ~ ^"always" ~ ^"update" ~ (^"set" ~ update_set_clause ~ ^"where" ~ update_where_clause)?
}

// ============================================================================
// DELETE Statement
// ============================================================================
// Syntax: DELETE FROM bundle WHERE <condition>
// Examples:
//   DELETE FROM bundle WHERE salary < 0
//   DELETE FROM bundle WHERE status = 'inactive' AND last_login < '2020-01-01'

delete_stmt = {
    ^"delete" ~ ^"from" ~ ^"bundle" ~ ^"where" ~ delete_where_clause
}

delete_where_clause = @{
    (!EOI ~ ANY)+
}

// ============================================================================
// UPDATE Statement
// ============================================================================
// Syntax: UPDATE bundle SET col = expr [, col = expr ...] WHERE <condition>
// Examples:
//   UPDATE bundle SET salary = salary * 1.1 WHERE department = 'eng'
//   UPDATE bundle SET status = NULL WHERE inactive = true
//   UPDATE bundle SET name = 'unknown', age = 0 WHERE name IS NULL

update_stmt = {
    ^"update" ~ ^"bundle" ~ ^"set" ~ update_set_clause ~ ^"where" ~ update_where_clause
}

update_set_clause = {
    update_assignment ~ ("," ~ update_assignment)*
}

update_assignment = {
    identifier ~ "=" ~ update_value_expr
}

// Value expression: everything up to the next comma-assignment or WHERE keyword
update_value_expr = @{
    (!(("," ~ WHITESPACE* ~ identifier ~ WHITESPACE* ~ "=") | (WHITESPACE+ ~ ^"where" ~ WHITESPACE+)) ~ ANY)+
}

update_where_clause = @{
    (!EOI ~ ANY)+
}

// ============================================================================
// FILTER Statement
// ============================================================================
// Syntax: FILTER WITH <query>
// Example: FILTER WITH SELECT * FROM bundle WHERE country = 'USA' AND age > 21

filter_stmt = {
    ^"filter" ~ ^"with" ~ filter_query
}

filter_query = @{
    // Capture everything from WITH to end as raw text
    // This allows DataFusion to parse the query later
    (!EOI ~ ANY)+
}

// ============================================================================
// ATTACH Statement
// ============================================================================
// Syntax: ATTACH '<path>' [TO <pack_name>] [WITH (<options>)]
// Examples:
//   ATTACH 'data.parquet'                    -- attaches to base pack
//   ATTACH 'data.parquet' TO users           -- attaches to 'users' join pack
//   ATTACH 'data.csv' WITH (delimiter = ',', header = true)

attach_stmt = {
    ^"attach" ~ quoted_string ~ (^"to" ~ identifier)? ~ (^"with" ~ with_options)?
}

with_options = {
    "(" ~ option_pair ~ ("," ~ option_pair)* ~ ")"
}

option_pair = {
    identifier ~ "=" ~ option_value
}

option_value = {
    quoted_string | number | boolean | identifier
}

boolean = { ^"true" | ^"false" }

// ============================================================================
// JOIN Statement
// ============================================================================
// Syntax: [join_type] JOIN '<source>' AS <name> ON <expression>
// Examples:
//   JOIN 'other.csv' AS other ON id = other.id
//   LEFT JOIN 'users.parquet' AS users ON user_id = users.id
//   FULL OUTER JOIN 'data.json' AS data ON key = data.key

join_stmt = {
    join_type? ~ ^"join" ~ quoted_string ~ ^"as" ~ identifier ~ ^"on" ~ join_condition
}

join_type = {
    (^"full" ~ ^"outer") | ^"full" | ^"left" | ^"right" | ^"inner" | ^"outer"
}

join_condition = @{
    // Capture everything from ON to end as raw text
    (!EOI ~ ANY)+
}

// ============================================================================
// REINDEX Statement
// ============================================================================
// Syntax: REINDEX [ON data(<column>)]
// Examples:
//   REINDEX
//   REINDEX ON data(id)

reindex_stmt = {
    ^"reindex" ~ (^"on" ~ ^"data" ~ "(" ~ identifier ~ ")")?
}

// ============================================================================
// IMPORT CONNECTOR Statement
// ============================================================================
// Syntax: IMPORT CONNECTOR <dotted_name> FROM '<runtime::entrypoint>' [WITH (<args>)]
// Examples:
//   IMPORT CONNECTOR acme.weather FROM 'ipc::./my_source'
//   IMPORT CONNECTOR acme.weather FROM 'ffi::./lib.so' WITH (platform = 'linux/amd64')

import_connector_stmt = {
    (^"load" | ^"import") ~ ^"connector" ~ dotted_identifier ~ ^"from" ~ quoted_string ~ (^"with" ~ source_args)?
}

// ============================================================================
// IMPORT TEMP CONNECTOR Statement
// ============================================================================
// Syntax: IMPORT TEMP CONNECTOR <dotted_name> FROM '<runtime::entrypoint>' [WITH (<args>)]
// Example: IMPORT TEMP CONNECTOR acme.weather FROM 'python::mod:Class'

import_temp_connector_stmt = {
    (^"load" | ^"import") ~ ^"temp" ~ ^"connector" ~ dotted_identifier ~ ^"from" ~ quoted_string ~ (^"with" ~ source_args)?
}

// ============================================================================
// DROP CONNECTOR Statement
// ============================================================================
// Syntax: DROP CONNECTOR <dotted_name> [FOR PLATFORM '<platform>']
// Examples:
//   DROP CONNECTOR acme.weather
//   DROP CONNECTOR acme.weather FOR PLATFORM 'linux/amd64'

drop_connector_stmt = {
    ^"drop" ~ ^"connector" ~ dotted_identifier ~ (^"for" ~ ^"platform" ~ quoted_string)?
}

// ============================================================================
// DROP TEMP CONNECTOR Statement
// ============================================================================
// Syntax: DROP TEMP CONNECTOR <dotted_name> [FOR PLATFORM '<platform>']
// Examples:
//   DROP TEMP CONNECTOR acme.weather
//   DROP TEMP CONNECTOR acme.weather FOR PLATFORM 'linux/amd64'

drop_temp_connector_stmt = {
    ^"drop" ~ ^"temp" ~ ^"connector" ~ dotted_identifier ~ (^"for" ~ ^"platform" ~ quoted_string)?
}

// ============================================================================
// IMPORT FUNCTION Statement
// ============================================================================
// Syntax: IMPORT FUNCTION <function_name> FROM '<runtime::entrypoint>' [WITH (<args>)]
// Examples:
//   IMPORT FUNCTION acme.double_val FROM 'ipc::./my_func'
//   IMPORT FUNCTION acme.* FROM 'ffi::./mylib.so'
//   IMPORT FUNCTION acme.double_val FROM 'ipc::./my_func' WITH (platform = 'linux/amd64')

import_function_stmt = {
    (^"load" | ^"import") ~ ^"function" ~ function_name ~ ^"from" ~ quoted_string ~ (^"with" ~ source_args)?
}

// ============================================================================
// IMPORT TEMP FUNCTION Statement
// ============================================================================
// Syntax: IMPORT TEMP FUNCTION <function_name> FROM '<runtime::entrypoint>' [WITH (<args>)]
// Examples:
//   IMPORT TEMP FUNCTION acme.double_val FROM 'python::mod:func'
//   IMPORT TEMP FUNCTION acme.* FROM 'ffi::./mylib.so'

import_temp_function_stmt = {
    (^"load" | ^"import") ~ ^"temp" ~ ^"function" ~ function_name ~ ^"from" ~ quoted_string ~ (^"with" ~ source_args)?
}

// ============================================================================
// DROP FUNCTION Statement
// ============================================================================
// Syntax: DROP FUNCTION <dotted_name>
// Example: DROP FUNCTION acme.double_val

drop_function_stmt = {
    ^"drop" ~ ^"function" ~ dotted_identifier
}

// ============================================================================
// DROP TEMP FUNCTION Statement
// ============================================================================
// Syntax: DROP TEMP FUNCTION <dotted_name>
// Example: DROP TEMP FUNCTION acme.double_val

drop_temp_function_stmt = {
    ^"drop" ~ ^"temp" ~ ^"function" ~ dotted_identifier
}

// ============================================================================
// RENAME CONNECTOR Statement
// ============================================================================
// Syntax: RENAME CONNECTOR <dotted_name> TO <dotted_name>
// Example: RENAME CONNECTOR acme.weather TO acme.weather_v2

rename_connector_stmt = {
    ^"rename" ~ ^"connector" ~ dotted_identifier ~ ^"to" ~ dotted_identifier
}

// ============================================================================
// RENAME TEMP CONNECTOR Statement
// ============================================================================
// Syntax: RENAME TEMP CONNECTOR <dotted_name> TO <dotted_name>
// Example: RENAME TEMP CONNECTOR acme.weather TO acme.weather_v2

rename_temp_connector_stmt = {
    ^"rename" ~ ^"temp" ~ ^"connector" ~ dotted_identifier ~ ^"to" ~ dotted_identifier
}

// ============================================================================
// RENAME FUNCTION Statement
// ============================================================================
// Syntax: RENAME FUNCTION <dotted_name> TO <dotted_name>
// Example: RENAME FUNCTION acme.double_val TO acme.double_val_v2

rename_function_stmt = {
    ^"rename" ~ ^"function" ~ dotted_identifier ~ ^"to" ~ dotted_identifier
}

// ============================================================================
// RENAME TEMP FUNCTION Statement
// ============================================================================
// Syntax: RENAME TEMP FUNCTION <dotted_name> TO <dotted_name>
// Example: RENAME TEMP FUNCTION acme.double_val TO acme.double_val_v2

rename_temp_function_stmt = {
    ^"rename" ~ ^"temp" ~ ^"function" ~ dotted_identifier ~ ^"to" ~ dotted_identifier
}

// ============================================================================
// CREATE SOURCE Statement
// ============================================================================
// Syntax: CREATE SOURCE [FOR <pack>] USING <connector> [WITH (<args>)]
// Examples:
//   CREATE SOURCE USING remote_dir WITH (url = 's3://bucket/data/', patterns = '**/*.parquet')
//   CREATE SOURCE FOR users USING remote_dir WITH (url = 'file:///data/')
//   CREATE SOURCE USING acme.weather WITH (custom_key = 'hello')
//   CREATE SOURCE USING acme.weather

create_source_stmt = {
    ^"create" ~ ^"source" ~ (^"for" ~ identifier)? ~ ^"using" ~ (dotted_identifier | identifier) ~ (^"with" ~ source_args)?
}

source_args = {
    "(" ~ source_arg_pair ~ ("," ~ source_arg_pair)* ~ ")"
}

source_arg_pair = {
    identifier ~ "=" ~ quoted_string
}

// ============================================================================
// FETCH Statement
// ============================================================================
// Syntax: FETCH ALL <mode> [DRY RUN] | FETCH <pack> <mode> [DRY RUN]
// Examples:
//   FETCH base ADD            -- fetch from base pack sources (add mode)
//   FETCH users ADD           -- fetch from 'users' pack sources
//   FETCH ALL ADD             -- fetch from all sources
//   FETCH ALL UPDATE          -- fetch all with update mode
//   FETCH users SYNC          -- fetch from 'users' with sync mode
//   FETCH base ADD DRY RUN    -- dry run: show what would change without executing
//   FETCH ALL SYNC DRY RUN   -- dry run for all sources in sync mode
fetch_stmt = {
    ^"fetch" ~ (^"all" ~ fetch_mode | identifier ~ fetch_mode) ~ fetch_dry_run?
}

fetch_mode = { ^"add" | ^"update" | ^"sync" }

fetch_dry_run = { ^"dry" ~ ^"run" }

// ============================================================================
// DROP JOIN Statement
// ============================================================================
// Syntax: DROP JOIN <name>
// Examples:
//   DROP JOIN customers

drop_join_stmt = {
    ^"drop" ~ ^"join" ~ identifier
}

// ============================================================================
// RENAME JOIN Statement
// ============================================================================
// Syntax: RENAME JOIN <old_name> TO <new_name>
// Examples:
//   RENAME JOIN customers TO clients

rename_join_stmt = {
    ^"rename" ~ ^"join" ~ identifier ~ ^"to" ~ identifier
}

// ============================================================================
// DROP INDEX Statement
// ============================================================================
// Syntax: DROP INDEX <column>
// Examples:
//   DROP INDEX user_id

drop_index_stmt = {
    ^"drop" ~ ^"index" ~ identifier
}

// ============================================================================
// RENAME VIEW Statement
// ============================================================================
// Syntax: RENAME VIEW <old_name> TO <new_name>
// Examples:
//   RENAME VIEW old_view TO new_view

rename_view_stmt = {
    ^"rename" ~ ^"view" ~ identifier ~ ^"to" ~ identifier
}

// ============================================================================
// Lexical Elements
// ============================================================================

function_name = @{
    // Function name: namespace.name or namespace.* for wildcard/bulk discovery
    identifier_segment ~ "." ~ (identifier_segment | "*")
}

dotted_identifier = @{
    // Dot-separated identifier: at least two segments (e.g., "acme.weather")
    identifier_segment ~ ("." ~ identifier_segment)+
}

identifier_segment = @{
    (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")*
}

identifier = @{
    // SQL identifier: double-quoted (allows any characters) or bare (alphanumeric/underscore)
    "\"" ~ (!"\"" ~ ANY)+ ~ "\""
    | (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")*
}

quoted_string = @{
    single_quoted | double_quoted
}

single_quoted = @{
    "'" ~ single_quoted_content ~ "'"
}

single_quoted_content = @{
    (sql_escaped_quote | escape_sequence | (!"'" ~ !"\\" ~ ANY))*
}

// SQL-style escaped single quote: two consecutive single quotes
sql_escaped_quote = @{ "''" }

double_quoted = @{
    "\"" ~ double_quoted_content ~ "\""
}

double_quoted_content = @{
    (escape_sequence | !"\"" ~ !"\\" ~ ANY)*
}

escape_sequence = @{
    "\\\\" | "\\'" | "\\\"" | "\\n" | "\\r" | "\\t"
}

number = @{
    "-"? ~ ASCII_DIGIT+ ~ ("." ~ ASCII_DIGIT+)? ~ (^"e" ~ ("+" | "-")? ~ ASCII_DIGIT+)?
}

// ============================================================================
// RESET Statement
// ============================================================================
// Syntax: RESET

reset_stmt = {
    ^"reset"
}

// ============================================================================
// UNDO Statement
// ============================================================================
// Syntax: UNDO

undo_stmt = {
    ^"undo"
}

// ============================================================================
// COMMIT Statement
// ============================================================================
// Syntax: COMMIT 'message'

commit_stmt = {
    ^"commit" ~ quoted_string
}

// ============================================================================
// DETACH Statement
// ============================================================================
// Syntax: DETACH 'location'

detach_stmt = {
    ^"detach" ~ quoted_string
}

// ============================================================================
// REBUILD INDEX Statement
// ============================================================================
// Syntax: REBUILD INDEX ON <column>

rebuild_index_stmt = {
    ^"rebuild" ~ ^"index" ~ ^"on" ~ identifier
}

// ============================================================================
// SET CONFIG Statement (runtime-only)
// ============================================================================
// Syntax: SET CONFIG <key> = '<value>' FOR '<scope>'
// Sets a config value for the current session only (not persisted).

set_config_stmt = {
    ^"set" ~ ^"config" ~ identifier ~ "=" ~ quoted_string ~ ^"for" ~ quoted_string
}

// ============================================================================
// SAVE CONFIG Statement
// ============================================================================
// Syntax: SAVE CONFIG <key> = '<value>' FOR '<scope>'

save_config_stmt = {
    ^"save" ~ ^"config" ~ identifier ~ "=" ~ quoted_string ~ ^"for" ~ quoted_string
}

// ============================================================================
// REPLACE Statement
// ============================================================================
// Syntax: REPLACE '<old_location>' WITH '<new_location>'

replace_stmt = {
    ^"replace" ~ quoted_string ~ ^"with" ~ quoted_string
}

// ============================================================================
// SET NAME Statement
// ============================================================================
// Syntax: SET NAME '<name>'

set_name_stmt = {
    ^"set" ~ ^"name" ~ quoted_string
}

// ============================================================================
// SET DESCRIPTION Statement
// ============================================================================
// Syntax: SET DESCRIPTION '<description>'

set_description_stmt = {
    ^"set" ~ ^"description" ~ quoted_string
}

// ============================================================================
// DROP VIEW Statement
// ============================================================================
// Syntax: DROP VIEW <name>

drop_view_stmt = {
    ^"drop" ~ ^"view" ~ identifier
}

// ============================================================================
// CREATE VIEW Statement
// ============================================================================
// Syntax: CREATE VIEW <name> AS <sql>

create_view_stmt = {
    ^"create" ~ ^"view" ~ identifier ~ ^"as" ~ view_sql
}

view_sql = @{
    (!EOI ~ ANY)+
}

// ============================================================================
// CREATE INDEX Statement
// ============================================================================
// Syntax: CREATE <index_type> INDEX ON <column>

create_index_stmt = {
    ^"create" ~ index_type ~ ^"index" ~ ^"on" ~ identifier
}

index_type = { ^"column" | ^"text" }

// ============================================================================
// DROP COLUMN Statement
// ============================================================================
// Syntax: DROP COLUMN <name>

drop_column_stmt = {
    ^"drop" ~ ^"column" ~ identifier
}

// ============================================================================
// RENAME COLUMN Statement
// ============================================================================
// Syntax: RENAME COLUMN <old_name> TO <new_name>

rename_column_stmt = {
    ^"rename" ~ ^"column" ~ identifier ~ ^"to" ~ identifier
}

// ============================================================================
// CAST COLUMN Statement
// ============================================================================
// Syntax: CAST COLUMN <name> TO <type>
// Examples:
//   CAST COLUMN price TO integer

cast_column_stmt = {
    ^"cast" ~ ^"column" ~ identifier ~ ^"to" ~ identifier
}

// ============================================================================
// ADD COLUMN Statement
// ============================================================================
// Syntax: ADD COLUMN <name> AS <expression>
// Examples:
//   ADD COLUMN full_name AS first_name || ' ' || last_name
//   ADD COLUMN total AS price * quantity

add_column_stmt = {
    ^"add" ~ ^"column" ~ identifier ~ ^"as" ~ add_column_expression
}

add_column_expression = @{
    (!EOI ~ ANY)+
}

// ============================================================================
// VERIFY DATA Statement
// ============================================================================
// Syntax: VERIFY DATA [UPDATE]

verify_data_stmt = {
    ^"verify" ~ ^"data" ~ (^"update")?
}

// ============================================================================
// EXPLAIN Statement
// ============================================================================
// Syntax: EXPLAIN [ANALYZE] [VERBOSE] [FORMAT format] [sql]
// Examples:
//   EXPLAIN
//   EXPLAIN ANALYZE
//   EXPLAIN VERBOSE
//   EXPLAIN ANALYZE VERBOSE FORMAT TREE
//   EXPLAIN SELECT * FROM bundle WHERE id > 10

explain_stmt = {
    ^"explain" ~ explain_analyze? ~ explain_verbose? ~ (^"format" ~ explain_format)? ~ explain_sql?
}

explain_analyze = { ^"analyze" }
explain_verbose = { ^"verbose" }
explain_format = { ^"indent" | ^"tree" | ^"graphviz" }

explain_sql = @{
    (!EOI ~ ANY)+
}

// ============================================================================
// DESCRIBE CONNECTOR Statement
// ============================================================================
// Syntax: DESCRIBE CONNECTOR <dotted_name>
// Example: DESCRIBE CONNECTOR acme.weather

describe_connector_stmt = {
    ^"describe" ~ ^"connector" ~ dotted_identifier
}

// ============================================================================
// DESCRIBE FUNCTION Statement
// ============================================================================
// Syntax: DESCRIBE FUNCTION <dotted_name>
// Example: DESCRIBE FUNCTION acme.double_val

describe_function_stmt = {
    ^"describe" ~ ^"function" ~ dotted_identifier
}

// ============================================================================
// DESCRIBE DATA Statement
// ============================================================================
// Syntax: DESCRIBE DATA IN <col1> [AS <type>], <col2> [AS <type>], ...
// Examples:
//   DESCRIBE DATA IN age, salary
//   DESCRIBE DATA IN secchi_depth_m AS DOUBLE, station_name
//   DESCRIBE DATA IN "First Name", id AS BIGINT

describe_data_stmt = {
    ^"describe" ~ ^"data" ~ ^"in" ~ describe_data_column_spec ~ ("," ~ describe_data_column_spec)*
}

describe_data_column_spec = {
    identifier ~ (^"as" ~ identifier)?
}
